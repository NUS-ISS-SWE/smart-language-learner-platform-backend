{
  "type": "json_schema",
  "json_schema": {
    "name": "sllp_grading_output",
    "strict": true,
    "schema": {
      "type": "object",
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string",
                "enum": [
                  "TASK_IDEAS",
                  "ORGANISATION_COHESION",
                  "GRAMMAR_SENTENCE_CONTROL",
                  "VOCABULARY_WORD_CHOICE",
                  "MECHANICS",
                  "EXPRESSION_DESCRIPTION_VOICE"
                ]
              },
              "bandScore": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "rationale": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "excerpt": { "type": "string" },
                    "location": { "type": ["string", "null"] }
                  },
                  "required": ["excerpt", "location"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["criterion", "bandScore", "rationale", "evidence"],
            "additionalProperties": false
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["criteria", "confidence"],
      "additionalProperties": false
    }
  }
}

