# Local Docker Compose configuration
# Copy this file to .env before starting the backend locally.
# TODO: Set both values to distinct 64-character hexadecimal secrets (for example,
# `openssl rand -hex 32`). Do not commit .env.

# HMAC secret used by services to authenticate private audit-event ingestion.
AUDIT_INGEST_SECRET=

# Password for the restricted sllp_runtime PostgreSQL role, including audit reads/inserts.
AUDIT_DB_PASSWORD=
