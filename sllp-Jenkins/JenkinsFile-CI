pipeline {
    agent any

    tools {
        jdk   'jdk-25'
        maven 'maven-3.9'
    }

    environment {
        DOCKER_CREDENTIALS_ID = 'docker-hub-credentials'
        GIT_CREDENTIALS_ID    = 'github-pat'
        DOCKER_HUB_USER       = 'maxin0525'
        // Java services live in the Maven reactor and share the sllp-contracts module.
        ALL_JAVA_SERVICES     = 'user-service liquibase-service document-service api-gateway composition-service evaluation-service product-guide-service evidence-service subscription-service admin-service'
        // Python services (FastAPI + pytest), built/tested independently of the Maven reactor.
        ALL_PYTHON_SERVICES   = 'orchestrator-service suggestions-agent'
    }

    parameters {
        string(name: 'BRANCH_NAME', defaultValue: 'main', description: 'Git branch to build')
        choice(name: 'MICROSERVICE_NAME', choices: [
            'all',
            'user-service',
            'liquibase-service',
            'document-service',
            'api-gateway',
            'composition-service',
            'evaluation-service',
            'product-guide-service',
            'evidence-service',
            'subscription-service',
            'admin-service',
            'orchestrator-service',
            'suggestions-agent'
        ], description: 'Select microservice to build (all = build & push every service)')
        booleanParam(name: 'RUN_TESTS',         defaultValue: true, description: 'Run unit tests')
        booleanParam(name: 'UPLOAD_DOCKER_HUB', defaultValue: true, description: 'Push image to Docker Hub')
    }

    stages {
        stage('Checkout') {
            steps {
                dir('source') {
                    git branch: "${params.BRANCH_NAME}",
                        credentialsId: "${GIT_CREDENTIALS_ID}",
                        url: 'https://github.com/NUS-ISS-SWE/smart-language-learner-platform-backend.git'
                }
            }
        }

        stage('Prepare') {
            steps {
                script {
                    def pySet = ALL_PYTHON_SERVICES.split(' ') as List
                    def selected = params.MICROSERVICE_NAME == 'all'
                        ? ((ALL_JAVA_SERVICES.split(' ') as List) + pySet)
                        : [params.MICROSERVICE_NAME]

                    env.JAVA_TARGETS   = selected.findAll { !pySet.contains(it) }.join(',')
                    env.PYTHON_TARGETS = selected.findAll {  pySet.contains(it) }.join(',')
                    env.ALL_TARGETS    = selected.join(',')

                    echo "Java targets:   ${env.JAVA_TARGETS ?: '(none)'}"
                    echo "Python targets: ${env.PYTHON_TARGETS ?: '(none)'}"
                }
            }
        }

        // stage('SAST - Semgrep') {
