<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="002_create_documents_table" author="system">
        <createTable tableName="documents">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT" nullable="false"/>
            <column name="file_name" type="VARCHAR(255)" nullable="false"/>
            <column name="file_size" type="BIGINT"/>
            <column name="file_type" type="VARCHAR(100)"/>
            <column name="s3_bucket" type="VARCHAR(255)"/>
            <column name="s3_key" type="VARCHAR(500)"/>
            <column name="s3_url" type="VARCHAR(1000)"/>
            <column name="uploaded_at" type="TIMESTAMP" nullable="false" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="documents" indexName="idx_documents_user_id">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
