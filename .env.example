# Local Docker Compose configuration
# Copy this file to .env before starting the backend locally.
# Use distinct 64-character hexadecimal secrets (for example, `openssl rand -hex 32`)
# when enabling audit ingestion. Do not commit .env.

# Optional HMAC secret used by services to authenticate private audit-event ingestion.
# Leave blank to disable cross-service audit ingestion locally.
AUDIT_INGEST_SECRET=

# Optional password for the restricted sllp_runtime PostgreSQL role, including audit reads/inserts.
# Local Compose uses `password` when this is blank; set a distinct strong password outside local development.
AUDIT_DB_PASSWORD=

# Required when starting the Product Guide service or the default A2A agent topology.
OPENAI_API_KEY=

# Optional locally. Without a key, the grading agent skips Lakera Guard screening.
LAKERA_GUARD_API_KEY=

# The default Compose topology uses AGENT_PROVIDER=a2a and starts all four agents.
# Use distinct high-entropy values; do not reuse the audit secret.
AGENT_PROVIDER=a2a
EVIDENCE_AGENT_TOKEN=
GRADING_AGENT_TOKEN=
REVIEW_AGENT_TOKEN=
SUGGESTION_AGENT_TOKEN=

# Development only: bypass the Review model while testing downstream A2A peers.
# Keep false outside local integration testing.
REVIEW_AUTO_APPROVE=false

# A model-backed assessment peer can take longer than a normal HTTP request.
AGENT_HTTP_TIMEOUT_SECONDS=60

# Stripe configuration for subscription payment links and webhook verification.
STRIPE_PAYMENT_LINK_BASIC=
STRIPE_PAYMENT_LINK_PREMIUM=
STRIPE_WEBHOOK_SECRET=

# Base Compose uses native AWS S3 for UAT and production. The local Compose overlay
# supplies LocalStack values automatically, so do not add real AWS credentials here
# for normal local development.
# The deployed IAM principal needs scoped GetObject, PutObject, and DeleteObject
# permissions for its environment's bucket only.
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required only with temporary AWS credentials (STS or IAM Identity Center).
AWS_SESSION_TOKEN=
# Set only for an approved S3-compatible service; leave blank for AWS S3.
AWS_S3_ENDPOINT=
# Leave blank for AWS S3. Set only when a custom endpoint must be browser-accessible.
AWS_S3_PUBLIC_ENDPOINT=
