pipeline {
    agent any

    tools {
        jdk   'jdk-25'
        maven 'maven-3.9'
    }

    environment {
        DOCKER_CREDENTIALS_ID = 'docker-hub-credentials'
        GIT_CREDENTIALS_ID    = 'github-pat'
        DOCKER_HUB_USER       = 'maxin0525'
        ALL_JAVA_SERVICES     = 'user-service liquibase-service document-service api-gateway composition-service evaluation-service review-service product-guide-service evidence-service subscription-service admin-service'
        ALL_PYTHON_SERVICES   = 'orchestrator-service suggestions-agent'
        OPENAI_API_KEY        = credentials('openai-api-key')
        COMPOSE_PROJECT_NAME  = "sllp-test-${env.BUILD_NUMBER}"
        GATEWAY_HOST_PORT     = '18080'
        INTEGRATION_TEST_SERVICES = 'postgres-db liquibase-service user-service admin-service subscription-service'
        LOAD_TEST_SERVICES        = 'postgres-db liquibase-service kafka-service user-service admin-service subscription-service composition-service orchestrator-service evidence-agent grading-agent review-agent suggestions-agent'
        AI_EVAL_SERVICES          = 'postgres-db liquibase-service kafka-service user-service admin-service subscription-service composition-service orchestrator-service evidence-agent grading-agent review-agent suggestions-agent'
        LAKERA_GUARD_API_KEY      = 'not-configured'
    }

    parameters {
        string(name: 'BRANCH_NAME', defaultValue: 'mx_CI_integration_test2', description: 'Git branch to build')
        choice(name: 'MICROSERVICE_NAME', choices: [
            'all',
            'user-service',
            'liquibase-service',
            'document-service',
            'api-gateway',
            'composition-service',
            'evaluation-service',
            'review-service',
            'product-guide-service',
            'evidence-service',
            'subscription-service',
            'admin-service',
            'orchestrator-service',
            'suggestions-agent'
        ], description: 'Select microservice to build (all = build & push every service)')
        booleanParam(name: 'RUN_UNIT_TESTS',         defaultValue: false, description: 'Run unit tests (with JaCoCo / pytest-cov coverage reports)')
        booleanParam(name: 'RUN_LLM_EVA_UNIT',       defaultValue: false,
                     description: 'Also run the unit tests tagged "llm" (EvidenceGoldenSetTest), which call the real OpenAI API — ' +
                                  'costs money. Requires RUN_UNIT_TESTS.')
        booleanParam(name: 'RUN_INTEGRATION_TESTS', defaultValue: false,
                     description: 'Start the full docker-compose stack and run the API integration tests')
        booleanParam(name: 'RUN_AI_EVAL',       defaultValue: false,
                     description: 'AI eval: 8 test essays (normal, Chinese, prompt injection + attack-free controls) through all agents, scored for ' +
                                  'integration, quality, security and drift against sllp-ai-eval/baseline.json ' +
                                  '(uses the real OpenAI key — costs money)')
        choice(name: 'SIMULATE_DRIFT', choices: ['none', 'evidence', 'grading', 'review', 'suggestions', 'all-agents'],
               description: 'Demo only (requires RUN_AI_EVAL): run the chosen agent(s) on DRIFT_MODEL instead of their normal ' +
                            'model, to show the drift check catching a silent model change. Cannot be combined with UPLOAD_DOCKER_HUB.')
        string(name: 'DRIFT_MODEL', defaultValue: 'gpt-4.1-nano', trim: true,
               description: 'OpenAI model used by SIMULATE_DRIFT')
        booleanParam(name: 'RUN_LOAD_TEST',     defaultValue: false,
                     description: 'Grading load test: 3 essays graded at once (uses the real OpenAI key — costs money)')
        booleanParam(name: 'KEEP_TEST_ENV',     defaultValue: false,
                     description: 'Leave the docker-compose test environment (started even without the tests) running after the build, ' +
                                  'e.g. to try a frontend against it on port 18080. The next build that starts a test environment removes it.')
        booleanParam(name: 'UPLOAD_DOCKER_HUB', defaultValue: false, description: 'Push image to Docker Hub')
        string(name: 'IMAGE_TAG', defaultValue: '', trim: true,
               description: 'Release tag pushed to Docker Hub (required when UPLOAD_DOCKER_HUB), format vX.Y.Z e.g. v1.0.0. ' +
                            'Must not already exist on Docker Hub — use a new version, or delete the old tag there first.')
    }

    stages {
        stage('Checkout') {
            steps {
                dir('source') {
                    git branch: "${params.BRANCH_NAME}",
                        credentialsId: "${GIT_CREDENTIALS_ID}",
                        url: 'https://github.com/NUS-ISS-SWE/smart-language-learner-platform-backend.git'
                }
            }
        }

        stage('Prepare') {
            steps {
                script {
                    def pySet = ALL_PYTHON_SERVICES.split(' ') as List
                    def selected = params.MICROSERVICE_NAME == 'all'
                        ? ((ALL_JAVA_SERVICES.split(' ') as List) + pySet)
                        : [params.MICROSERVICE_NAME]

                    env.JAVA_TARGETS   = selected.findAll { !pySet.contains(it) }.join(',')
                    env.PYTHON_TARGETS = selected.findAll {  pySet.contains(it) }.join(',')
                    env.ALL_TARGETS    = selected.join(',')

                    echo "Java targets:   ${env.JAVA_TARGETS ?: '(none)'}"
                    echo "Python targets: ${env.PYTHON_TARGETS ?: '(none)'}"

                    if (params.RUN_LLM_EVA_UNIT && !params.RUN_UNIT_TESTS) {
                        error 'RUN_LLM_EVA_UNIT runs as part of the unit tests: enable RUN_UNIT_TESTS as well.'
                    }

                    env.REVIEW_AUTO_APPROVE = params.RUN_AI_EVAL ? 'false' : 'true'

                    env.DRIFT_LABEL = ''
                    if (params.SIMULATE_DRIFT != 'none') {
                        if (!params.RUN_AI_EVAL) {
                            error 'SIMULATE_DRIFT only has an effect together with RUN_AI_EVAL'
                        }
                        if (params.UPLOAD_DOCKER_HUB) {
                            error 'SIMULATE_DRIFT is a demo run and must not push images: untick UPLOAD_DOCKER_HUB'
                        }
                        if (!(params.DRIFT_MODEL ==~ /^[A-Za-z0-9._:-]+$/)) {
                            error "DRIFT_MODEL '${params.DRIFT_MODEL}' is not a valid model name"
                        }
                        env.DRIFT_LABEL = "${params.SIMULATE_DRIFT} model swapped to ${params.DRIFT_MODEL}"
                    }


                    if (params.UPLOAD_DOCKER_HUB) {
                        if (!(params.IMAGE_TAG ==~ /^v\d+\.\d+\.\d+$/)) {
                            error "IMAGE_TAG '${params.IMAGE_TAG}' is invalid: expected vX.Y.Z, e.g. v1.0.0"
                        }
                        withCredentials([usernamePassword(
                            credentialsId: "${DOCKER_CREDENTIALS_ID}",
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASS'
                        )]) {
                            sh 'echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin'
                            def taken = selected.findAll { svc ->
                                sh(script: "docker manifest inspect ${DOCKER_HUB_USER}/sllp-${svc}:${params.IMAGE_TAG} > /dev/null 2>&1",
                                   returnStatus: true) == 0
                            }
                            if (taken) {
                                error "Tag ${params.IMAGE_TAG} already exists on Docker Hub for: ${taken.join(', ')}. " +
                                      "Use a new version, or delete that tag on Docker Hub first."
                            }
                        }
                        currentBuild.description = "Image tag: ${params.IMAGE_TAG}"
                    }
                }
            }
        }

        stage('SAST - Semgrep') {
            steps {
                sh '''
                    mkdir -p semgrep-reports
                    # p/ci is Semgrep's free default ruleset (covers Java and Python).
                    docker run --rm \
                        -v "$(pwd):/workspace" \
                        -w /workspace \
                        semgrep/semgrep \
                        semgrep scan --config p/ci \
                            --json-output=semgrep-reports/semgrep-report.json \
                            --sarif-output=semgrep-reports/semgrep-report.sarif \
                            source
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'semgrep-reports/semgrep-report.*', allowEmptyArchive: true

                    recordIssues(
                        enabledForFailure: true,
                        skipBlames: true,
                        tool: sarif(id: 'semgrep', name: 'Semgrep',
                                    pattern: 'semgrep-reports/semgrep-report.sarif')
                    )
                }
            }
        }

        stage('Build & Test - Java') {
            when { expression { return env.JAVA_TARGETS } }
            steps {
                dir('source') {
                    script {
                        def modules = env.JAVA_TARGETS.split(',').collect { "sllp-${it}" }.join(',')
                        if (params.RUN_UNIT_TESTS) {

                            def excluded = params.RUN_LLM_EVA_UNIT ? '' : 'llm'
                            sh "mvn -pl ${modules} -am clean verify -Dtest.excludedGroups=${excluded} --no-transfer-progress"
                        } else {
                            sh "mvn -pl ${modules} -am clean package -DskipTests --no-transfer-progress"
                        }
                    }
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'source/sllp-*/target/surefire-reports/*.xml'

                    sh '''
                        rm -rf unit-test-reports/java && mkdir -p unit-test-reports/java
                        for f in source/sllp-*/target/surefire-reports/TEST-*.xml; do
                            [ -f "$f" ] && cp "$f" unit-test-reports/java/ || true
                        done
                    '''
                    archiveArtifacts artifacts: 'unit-test-reports/java/*.xml', allowEmptyArchive: true
                    script {
                        if (params.RUN_UNIT_TESTS) {

                            withEnv(["COVERAGE_TARGETS=${env.JAVA_TARGETS.replace(',', ' ')}"]) {
                                sh '''
                                    rm -rf coverage-reports/java && mkdir -p coverage-reports/java
                                    for svc in $COVERAGE_TARGETS; do
                                        r="source/sllp-$svc/target/site/jacoco"
                                        [ -f "$r/jacoco.xml" ] && cp -r "$r" "coverage-reports/java/$svc" || true
                                    done
                                '''
                            }
                            publishCoverage('java', 'Java Coverage (JaCoCo)', 'JACOCO', 'jacoco.xml',
                                            'JaCoCo Report', 'src/main/java')
                        }
                    }
                }
            }
        }

        stage('Build & Test - Python') {
            when { expression { return env.PYTHON_TARGETS } }
            steps {
                dir('source') {
                    script {
                        env.PYTHON_TARGETS.split(',').each { svc ->
                            dir("sllp-${svc}") {

                                sh '''
                                    rm -rf .venv
                                    python3.12 -m venv .venv
                                    .venv/bin/pip install --quiet --upgrade pip
                                    .venv/bin/pip install --quiet -r requirements.txt pytest pytest-cov
                                    rm -rf .coverage coverage.xml htmlcov
                                    # Coverage settings (branch, source=app) are in pyproject.toml.
                                    .venv/bin/pytest --junitxml=pytest-report.xml \
                                        --cov --cov-report=xml:coverage.xml --cov-report=html:htmlcov
                                '''
                            }
                        }
                    }
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'source/sllp-*/pytest-report.xml'
                    sh '''
                        rm -rf unit-test-reports/python && mkdir -p unit-test-reports/python
                        for f in source/sllp-*/pytest-report.xml; do
                            [ -f "$f" ] && cp "$f" "unit-test-reports/python/$(basename "$(dirname "$f")").xml" || true
                        done
                    '''
                    archiveArtifacts artifacts: 'unit-test-reports/python/*.xml', allowEmptyArchive: true
                    withEnv(["COVERAGE_TARGETS=${env.PYTHON_TARGETS.replace(',', ' ')}"]) {
                        sh '''
                            rm -rf coverage-reports/python && mkdir -p coverage-reports/python
                            for svc in $COVERAGE_TARGETS; do
                                d="source/sllp-$svc"
                                if [ -f "$d/coverage.xml" ]; then
                                    mkdir -p "coverage-reports/python/$svc"
                                    cp -r "$d/htmlcov/." "coverage-reports/python/$svc/" || true
                                    cp "$d/coverage.xml" "coverage-reports/python/$svc/"
                                fi
                            done
                        '''
                    }
                    publishCoverage('python', 'Python Coverage (pytest-cov)', 'COBERTURA', 'coverage.xml',
                                    'Python Coverage Report', 'app')
                }
            }
        }


        stage('Start Test Environment') {
            when { expression { return params.RUN_INTEGRATION_TESTS || params.RUN_AI_EVAL || params.RUN_LOAD_TEST || params.KEEP_TEST_ENV } }
            environment {

                AGENT_PROVIDER      = 'a2a'
            }
            steps {
                dir('source') {
                    script {
                        if (params.SIMULATE_DRIFT != 'none') {

                            def modelEnv = [
                                'evidence'   : ['evidence-agent',    ['SPRING_AI_OPENAI_CHAT_MODEL', 'SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL']],
                                'grading'    : ['grading-agent',     ['OPENAI_CHAT_MODEL']],
                                'review'     : ['review-agent',      ['REVIEW_OPENAI_MODEL']],
                                'suggestions': ['suggestions-agent', ['SUGGESTIONS_OPENAI_MODEL']]
                            ]
                            def driftAgents = params.SIMULATE_DRIFT == 'all-agents' ? modelEnv.keySet() as List : [params.SIMULATE_DRIFT]
                            def overlay = 'services:\n' + driftAgents.collect { agent ->
                                def service = modelEnv[agent][0]
                                def vars = modelEnv[agent][1]
                                "  ${service}:\n    environment:\n" + vars.collect { "      ${it}: \"${params.DRIFT_MODEL}\"\n" }.join('')
                            }.join('')
                            writeFile file: '../drift-overlay.yaml', text: overlay
                            env.COMPOSE_FILE = "docker-compose.yaml:docker-compose.override.yaml:${env.WORKSPACE}/drift-overlay.yaml"
                            echo "SIMULATE_DRIFT: ${env.DRIFT_LABEL}\n${overlay}"
                        }

                        def startStack = '''
                            # A KEEP_TEST_ENV build leaves its environment running; it holds the
                            # same fixed host ports, so remove any such leftover before starting.
                            for p in $(docker ps -a --filter label=com.docker.compose.project \
                                           --format '{{.Label "com.docker.compose.project"}}' | grep '^sllp-test-' | sort -u); do
                                echo "Removing leftover test environment $p"
                                docker compose -p "$p" down -v --remove-orphans || true
                            done

                            for v in EVIDENCE_AGENT_TOKEN GRADING_AGENT_TOKEN REVIEW_AGENT_TOKEN SUGGESTION_AGENT_TOKEN INTERNAL_SERVICE_TOKEN; do
                                export "$v=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \\n')"
                            done

                            if [ -n "$TEST_ENV_SERVICES" ]; then
                                # These services' depends_on all stay within the set, so compose
                                # still orders them (liquibase finishes before the apps start).
                                docker compose up -d --build $TEST_ENV_SERVICES
                                # api-gateway depends_on every backend service; --no-deps stops
                                # compose from pulling all of them in. Routes to services that
                                # aren't running just fail, and the tests don't call them.
                                docker compose up -d --build --no-deps api-gateway
                            else
                                docker compose up -d --build
                            fi

                            echo "Waiting for api-gateway to accept requests..."
                            for i in $(seq 1 60); do
                                if curl -sf http://localhost:$GATEWAY_HOST_PORT/api/v1/subscription/plans > /dev/null; then
                                    echo "Gateway is ready."
                                    break
                                fi
                                if [ "$i" = 60 ]; then
                                    echo "Gateway did not become ready in time."
                                    docker compose logs --tail=200
                                    exit 1
                                fi
                                sleep 5
                            done
                        '''
                        def services = [] as LinkedHashSet
                        if (!params.KEEP_TEST_ENV) {
                            if (params.RUN_INTEGRATION_TESTS) { services.addAll(INTEGRATION_TEST_SERVICES.split(' ') as List) }
                            if (params.RUN_AI_EVAL)           { services.addAll(AI_EVAL_SERVICES.split(' ') as List) }
                            if (params.RUN_LOAD_TEST)         { services.addAll(LOAD_TEST_SERVICES.split(' ') as List) }
                        }
                        def targets = services.join(' ')
                        echo targets ? "Starting ${targets} api-gateway" : 'Starting every service'

                        def lakeraConfigured = true
                        try {
                            withCredentials([string(credentialsId: 'lakera-api-key', variable: 'LAKERA_PROBE')]) { }
                        } catch (err) {
                            lakeraConfigured = false
                        }
                        env.LAKERA_CONFIGURED = lakeraConfigured ? 'true' : 'false'
                        withEnv(["TEST_ENV_SERVICES=${targets}"]) {
                            if (lakeraConfigured) {
                                withCredentials([string(credentialsId: 'lakera-api-key', variable: 'LAKERA_GUARD_API_KEY')]) {
                                    sh startStack
                                }
                            } else {
                                echo "No 'lakera-api-key' credential: the grading agent runs without Lakera Guard screening."
                                sh startStack
                            }
                        }
                        if (params.RUN_LOAD_TEST || params.RUN_AI_EVAL) {

                            sh '''
                                echo "Waiting for orchestrator and assessment agents..."
                                for i in $(seq 1 60); do
                                    if docker compose exec -T orchestrator-service python -c \
                                        "import urllib.request; urllib.request.urlopen('http://localhost:8090/ready')" 2>/dev/null; then
                                        echo "Orchestrator is ready."
                                        break
                                    fi
                                    if [ "$i" = 60 ]; then
                                        echo "Orchestrator did not become ready in time."
                                        docker compose logs --tail=200 orchestrator-service evidence-agent grading-agent review-agent suggestions-agent
                                        exit 1
                                    fi
                                    sleep 5
                                done
                            '''
                        }
                    }
                }
            }
        }

        stage('Integration Test - API') {
            when { expression { return params.RUN_INTEGRATION_TESTS } }
            steps {
                dir('source/sllp-integration-tests') {

                    sh '''
                        npm ci
                        GATEWAY_BASE_URL=http://localhost:$GATEWAY_HOST_PORT npx playwright test
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'source/sllp-integration-tests/test-results/junit.xml'
                    sh '''
                        rm -rf integration-test-reports && mkdir -p integration-test-reports
                        cp source/sllp-integration-tests/test-results/junit.xml integration-test-reports/ || true
                        cp -r source/sllp-integration-tests/playwright-report integration-test-reports/html || true
                    '''
                    archiveArtifacts artifacts: 'integration-test-reports/**', allowEmptyArchive: true
                }
            }
        }

        stage('AI Eval - Quality, Security & Drift') {

            when { expression { return params.RUN_AI_EVAL } }
            steps {
                dir('source') {
                    script {
                        def rc = sh(returnStatus: true, script: '''
                            rm -rf "$WORKSPACE/ai-eval-reports"
                            python3.12 sllp-ai-eval/run_eval.py \
                                --gateway "http://localhost:$GATEWAY_HOST_PORT" \
                                --compose-dir . \
                                --out "$WORKSPACE/ai-eval-reports" \
                                --build "$BUILD_NUMBER" \
                                --drift-simulation "$DRIFT_LABEL" \
                                --lakera "$LAKERA_CONFIGURED"
                        ''')
                        if (rc == 2) {
                            unstable('AI eval: quality drifted from the baseline (see AI Eval Report)')
                        } else if (rc != 0) {
                            error('AI eval: a release gate failed (see AI Eval Report)')
                        }
                    }
                }
            }
            post {
                always {
                    script {
                        if (fileExists('ai-eval-reports/ai-eval-summary.txt')) {
                            def summary = readFile('ai-eval-reports/ai-eval-summary.txt').trim()
                            currentBuild.description = currentBuild.description
                                ? "${currentBuild.description}<br>${summary}"
                                : summary
                        }
                    }

                    junit allowEmptyResults: true, testResults: 'ai-eval-reports/ai-eval-junit.xml'

                    archiveArtifacts artifacts: 'ai-eval-reports/**', allowEmptyArchive: true
                    publishHTML(target: [
                        reportName           : 'AI Eval Report',
                        reportDir            : 'ai-eval-reports',
                        reportFiles          : 'ai-eval-report.html',
                        keepAll              : true,
                        alwaysLinkToLastBuild: true,
                        allowMissing         : true
                    ])
                }
            }
        }

        stage('Load Test - Grading') {

            when { expression { return params.RUN_LOAD_TEST } }
            steps {

                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    sh '''
                        rm -rf load-test-reports && mkdir -p load-test-reports
                        docker run --rm \
                            --user "$(id -u):$(id -g)" \
                            --network "${COMPOSE_PROJECT_NAME}_sllp-network" \
                            -v "$WORKSPACE/source/sllp-load-tests:/scripts:ro" \
                            -v "$WORKSPACE/load-test-reports:/reports" \
                            -e GATEWAY_BASE_URL=http://api-gateway:8080 \
                            -e REPORT_DIR=/reports \
                            -e ESSAY_COUNT=3 \
                            -e REVIEW_AUTO_APPROVE="$REVIEW_AUTO_APPROVE" \
                            grafana/k6 run /scripts/grading-load.js
                    '''
                }
            }
            post {
                always {
                    script {
                        if (fileExists('load-test-reports/load-test-summary.txt')) {
                            def summary = readFile('load-test-reports/load-test-summary.txt').trim()
                            currentBuild.description = currentBuild.description
                                ? "${currentBuild.description}<br>${summary}"
                                : summary
                        }
                    }
                    archiveArtifacts artifacts: 'load-test-reports/**', allowEmptyArchive: true
                    // Adds a "Load Test Report" link to the build page (HTML Publisher plugin),
                    // so the report opens in the browser without downloading the artifact.
                    publishHTML(target: [
                        reportName           : 'Load Test Report',
                        reportDir            : 'load-test-reports',
                        reportFiles          : 'load-test-report.html',
                        keepAll              : true,
                        alwaysLinkToLastBuild: true,
                        allowMissing         : true
                    ])
                }
            }
        }

        stage('Stop Test Environment') {
            when { expression { return (params.RUN_INTEGRATION_TESTS || params.RUN_AI_EVAL || params.RUN_LOAD_TEST) && !params.KEEP_TEST_ENV } }
            steps {
                dir('source') {
                    sh 'docker compose down -v --remove-orphans || true'
                }
            }
        }

        stage('Docker Build & Push') {
            when { expression { return params.UPLOAD_DOCKER_HUB } }
            environment {
                DOCKER_BUILDKIT = '1'
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: "${DOCKER_CREDENTIALS_ID}",
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh 'echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin'

                    script {
                        env.ALL_TARGETS.split(',').each { svc ->
                            def img = "${DOCKER_HUB_USER}/sllp-${svc}"
                            // Build context must be the repo root: these Dockerfiles COPY
                            // pom.xml / sllp-contracts from the root for the reactor build.
                            sh """
                                docker build -f source/sllp-${svc}/Dockerfile -t ${img}:${params.IMAGE_TAG} -t ${img}:latest source
                                docker push ${img}:${params.IMAGE_TAG}
                                docker push ${img}:latest
                            """
                        }
                    }
                }
            }
        }

        stage('Trivy Image Scan') {
            when { expression { return params.UPLOAD_DOCKER_HUB } }
            steps {
                script {
                    sh '''
                        mkdir -p trivy-reports
                        curl -fsSL -o trivy-junit.tpl \
                            https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/junit.tpl
                        mkdir -p /tmp/trivy-cache
                    '''

                    env.ALL_TARGETS.split(',').each { svc ->
                        def img = "${DOCKER_HUB_USER}/sllp-${svc}:${params.IMAGE_TAG}"
                        sh """
                            docker run --rm \
                                -v /var/run/docker.sock:/var/run/docker.sock \
                                -v \$(pwd):/workspace \
                                -v /tmp/trivy-cache:/root/.cache/ \
                                -w /workspace \
                                aquasec/trivy image \
                                --exit-code 0 --severity HIGH,CRITICAL \
                                --format template --template '@/workspace/trivy-junit.tpl' \
                                -o trivy-reports/${svc}-junit.xml ${img}

                            docker run --rm \
                                -v /var/run/docker.sock:/var/run/docker.sock \
                                -v \$(pwd):/workspace \
                                -v /tmp/trivy-cache:/root/.cache/ \
                                -w /workspace \
                                aquasec/trivy image \
                                --exit-code 0 --severity HIGH,CRITICAL \
                                --format json -o trivy-reports/${svc}-report.json ${img}
                        """
                    }
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'trivy-reports/*-junit.xml'
                    archiveArtifacts artifacts: 'trivy-reports/*-report.json', allowEmptyArchive: true
                    recordIssues(
                        enabledForFailure: true,
                        skipBlames: true,
                        tool: trivy(id: 'trivy', name: 'Trivy',
                                    pattern: 'trivy-reports/*-report.json')
                    )
                }
            }
        }
    }

    post {
        always {
            script {
                if (params.KEEP_TEST_ENV) {
                    echo "KEEP_TEST_ENV: test environment ${COMPOSE_PROJECT_NAME} left running " +
                         "(api-gateway on host port ${GATEWAY_HOST_PORT}). Remove it with: " +
                         "docker compose -p ${COMPOSE_PROJECT_NAME} down -v --remove-orphans"
                    currentBuild.description = (currentBuild.description ? "${currentBuild.description}<br>" : '') +
                        "Test env kept running: ${COMPOSE_PROJECT_NAME}"
                } else {
                    dir('source') {
                        sh 'docker compose down -v --remove-orphans || true'
                    }
                }
            }
        }
        success {
            echo params.UPLOAD_DOCKER_HUB
                ? "CI complete — ${params.MICROSERVICE_NAME} pushed to Docker Hub as ${params.IMAGE_TAG}"
                : "CI complete — ${params.MICROSERVICE_NAME} built (not pushed)"
        }
        failure { echo "CI failed for ${params.MICROSERVICE_NAME}" }
    }
}


def publishCoverage(String lang, String title, String parser, String xmlName, String htmlName, String srcSubdir) {
    def services = sh(script: "ls coverage-reports/${lang} 2>/dev/null || true", returnStdout: true)
                       .trim().split('\\s+').findAll { it }
    if (!services) {
        echo "No ${lang} coverage report found."
        return
    }
    recordCoverage(id: "${lang}-coverage", name: title,
                   tools: [[parser: parser, pattern: "coverage-reports/${lang}/*/${xmlName}"]],
                   sourceDirectories: services.collect { [path: "source/sllp-${it}/${srcSubdir}"] },
                   sourceCodeRetention: 'LAST_BUILD',
                   enabledForFailure: true,
                   skipPublishingChecks: true)
    publishHTML(target: [
        reportName           : htmlName,
        reportDir            : "coverage-reports/${lang}",
        reportFiles          : services.collect { "${it}/index.html" }.join(','),
        reportTitles         : services.join(','),
        keepAll              : true,
        alwaysLinkToLastBuild: true,
        allowMissing         : true
    ])
    archiveArtifacts artifacts: "coverage-reports/${lang}/**", allowEmptyArchive: true
}
