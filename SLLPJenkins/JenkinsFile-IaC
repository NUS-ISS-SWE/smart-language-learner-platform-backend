pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        string(name: 'BRANCH_NAME', defaultValue: 'mx_cici_clean_test', description: 'Git branch containing Terraform code')
        choice(name: 'TF_ACTION', choices: ['apply', 'destroy'], description: 'Terraform action')
    }

    stages {
        stage('Checkout Terraform Code') {
            steps {
                dir('source') {
                    git branch: "${params.BRANCH_NAME}",
                        credentialsId: "github-pat",
                        url: 'https://github.com/NUS-ISS-SWE/smart-language-learner-platform-backend.git'
                }
            }
        }

        stage('Check Tools') {
            steps {
                sh '''
                    echo "Checking environment tools..."
                    aws --version       || echo "⚠️  AWS CLI not found — install via: sudo yum install awscli -y"
                    terraform -version  || echo "⚠️  Terraform not found — see setup guide"
                '''
            }
        }

        stage('Terraform Init & Validate') {
            steps {
                dir('source/terraform') {
                    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                      credentialsId: 'aws-credentials']]) {
                        sh '''
                            terraform init -input=false
                            terraform fmt -check -recursive
                            terraform validate
                        '''
                    }
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('source/terraform') {
                    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                      credentialsId: 'aws-credentials']]) {
                        script {
                            def destroyFlag = params.TF_ACTION == 'destroy' ? '-destroy' : ''
                            sh """
                                terraform plan ${destroyFlag} -input=false -out=tfplan
                                terraform show -no-color tfplan > tfplan.txt
                            """
                        }
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'source/terraform/tfplan.txt', allowEmptyArchive: true
                }
            }
        }

        stage('Approval') {
            steps {
                input message: "确认要对环境执行 terraform ${params.TF_ACTION} 吗？先看一下上面 Plan stage 归档的 tfplan.txt。",
                      ok: 'Proceed'
            }
        }

        stage('Terraform Apply / Destroy') {
            steps {
                dir('source/terraform') {
                    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                      credentialsId: 'aws-credentials']]) {
                        sh 'terraform apply -input=false tfplan'
                    }
                }
            }
        }
    }

    post {
        success { echo "✅ Terraform ${params.TF_ACTION} completed successfully!" }
        failure { echo "❌ Terraform ${params.TF_ACTION} failed. Check console output." }
        aborted { echo "🚫 Terraform ${params.TF_ACTION} was not approved." }
    }
}
